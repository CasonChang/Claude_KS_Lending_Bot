# 複製成 .env 後填入，所有值都不要 commit
# ── Bitfinex（沒填 = 自動進入 DRY_RUN 模擬模式）─────────────
# 權限只需要：Account Info(讀) + Margin Funding(讀寫) + Wallets(讀)，不要開提幣！
BFX_API_KEY=
BFX_API_SECRET=

# ── 模式 ──────────────────────────────────────────────
# true = 完整跑策略但不真正下單（本機測試用）
DRY_RUN=true

# 每幣別「全部放貸中＋全部掛單中」本金上限（含階梯、FRR、120天固定）
# 留白 = 不限制；0 = 停止新增／撤回未成交單，已放貸的等自然還款。
# Zeabur 修改後須重新部署；USDT 的 Bitfinex symbol 是 fUST。
LENDING_MAX_USD=
LENDING_MAX_USDT=

# 每個幣別「所有 120 天掛單中＋放貸中」（含 FRR／固定利率）的固定金額上限
# 分幣別設定優先；留白沿用 LONG_TERM_MAX_AMOUNT／FRR_MAX_AMOUNT／config.yaml。
# 0 = 不新增該幣別的 120 天部位；已掛單／放貸不強制撤回。
# Telegram：/longcap USD 1200、/longcap USDT 500；/longcap 1200 同時改兩幣別。
LONG_TERM_MAX_USD=
LONG_TERM_MAX_USDT=
# 舊共用預設，仍可保留；FRR_MAX_AMOUNT 僅保留舊部署相容。
LONG_TERM_MAX_AMOUNT=

# ── Telegram（@BotFather 建 bot 拿 token；chat id 可問 @userinfobot）──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Supabase（沒填 = 不寫 DB，純本機跑也 OK）────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
